---
// src/components/CourseCard.astro
// Shared row-style card used by the Inmersiones, Bautizos, Sidemount and
// Cursos views. Renders a title, meta badges, body paragraphs (each with an
// optional label) — as a plain paragraph, a <ul><li> list when `items` is
// given, or a two-color concept/price list when `supplements` is given — a
// price and an optional media block. When both videoUrl and image are
// present the video wins, matching the Bautizos behaviour.
import rowStyles from '../styles/rowLayout.module.css'

interface Props {
  title: string
  category?: { key: string; label: string } | null
  isPackage?: boolean
  packageLabel?: string
  agencyLogo?: string | null
  agencyName?: string
  meta?: string[]
  paragraphs?: Array<{
    label?: string
    text?: string
    items?: string[]
    supplements?: Array<{ label: string; price: string }>
  }>
  price?: string | null
  image?: string | null
  videoUrl?: string | null
  headingLevel?: 2 | 3 | 4
  // Reserve button: reserveHref points either at the item's direct Bukyapp
  // product page (reserveExternal true, opens in a new tab) or at the
  // contact form with a prefilled message (reserveExternal false, same tab).
  reserveHref?: string | null
  reserveLabel?: string
  reserveExternal?: boolean
}

const {
  title,
  category = null,
  isPackage = false,
  packageLabel = 'Bono / Pack',
  agencyLogo = null,
  agencyName = '',
  meta = [],
  paragraphs = [],
  price,
  image,
  videoUrl,
  headingLevel = 3,
  reserveHref = null,
  reserveLabel = 'Reservar',
  reserveExternal = false,
} = Astro.props

// Course category badges read as a depth cue: recreational courses stay
// shallow (light), specialty sits mid-water, technical goes deep (dark) —
// mirroring the depth limits that actually separate these tracks.
const categoryVariant: Record<string, string> = {
  recreational: rowStyles.categoryBadgeRecreational,
  specialty: rowStyles.categoryBadgeSpecialty,
  technical: rowStyles.categoryBadgeTechnical,
}

// Icons are single-color line art masked with currentColor (see
// .categoryIcon), so the same asset works on both the light recreational
// badge and the dark specialty/technical ones without separate colored files.
const categoryIcon: Record<string, string> = {
  recreational: '/assets/icons/recreational.webp',
  specialty: '/assets/icons/specialty.webp',
  technical: '/assets/icons/technical.webp',
}

// Converts youtu.be / youtube.com watch or embed links into privacy-enhanced
// youtube-nocookie embeds with the player chrome hidden. Deliberately NOT
// autoplayed: pages that list several videos would load them all at once —
// the user clicks the placeholder to play each one.
// https://www.youtube-nocookie.com/embed/VIDEO_ID?controls=0
const m = videoUrl
  ? videoUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([A-Za-z0-9_-]{11})/)
  : null
const embedUrl = m ? `https://www.youtube-nocookie.com/embed/${m[1]}?controls=0` : null

const Tag = `h${headingLevel}` as 'h2' | 'h3' | 'h4'
---

<article class={rowStyles.row}>
  {category ? (
    <span class={`${rowStyles.categoryBadge} ${categoryVariant[category.key] ?? ''}`}>
      {categoryIcon[category.key] ? (
        <span
          class={rowStyles.categoryIcon}
          style={`--icon: url(${categoryIcon[category.key]})`}
          aria-hidden="true"
        />
      ) : null}
      {category.label}
    </span>
  ) : isPackage ? (
    <span class={`${rowStyles.categoryBadge} ${rowStyles.categoryBadgePackage}`}>
      {packageLabel}
    </span>
  ) : null}
  <div class={rowStyles.rowBody}>
    <div class={rowStyles.titleRow}>
      {agencyLogo ? (
        <img
          src={agencyLogo}
          alt={agencyName}
          class={rowStyles.agencyLogo}
          loading="lazy"
        />
      ) : null}
      <Tag class={rowStyles.cardTitle}>{title}</Tag>
    </div>
    {meta.length > 0 ? (
      <ul class={rowStyles.cardMeta}>
        {meta.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : null}
    {paragraphs.map((p) =>
      p.supplements && p.supplements.length > 0 ? (
        <div class={rowStyles.cardBody}>
          {p.label ? <strong>{p.label}</strong> : null}
          <ul class={rowStyles.supplementList}>
            {p.supplements.map((s) => (
              <li>
                <span class={rowStyles.supplementLabel}>{s.label}</span>
                <span class={rowStyles.supplementPrice}>{s.price}</span>
              </li>
            ))}
          </ul>
        </div>
      ) : p.items && p.items.length > 0 ? (
        <div class={rowStyles.cardBody}>
          {p.label ? <strong>{p.label}: </strong> : null}
          <ul class={rowStyles.cardList}>
            {p.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ) : p.text ? (
        <p class={rowStyles.cardBody}>
          {p.label ? <strong>{p.label}: </strong> : null}
          {p.text}
        </p>
      ) : null,
    )}
    {price || reserveHref ? (
      <div class={rowStyles.cardFooter}>
        {price ? <p class={rowStyles.cardPrice}>{price}</p> : null}
        {reserveHref ? (
          <a
            class={rowStyles.reserveButton}
            href={reserveHref}
            target={reserveExternal ? '_blank' : undefined}
            rel={reserveExternal ? 'noopener noreferrer' : undefined}
          >
            {reserveLabel}
          </a>
        ) : null}
      </div>
    ) : null}
  </div>
  {embedUrl ? (
    <div class={rowStyles.rowMedia}>
      <div class={rowStyles.rowVideo}>
        <iframe
          src={embedUrl}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowFullScreen
        />
      </div>
    </div>
  ) : image ? (
    <div class={rowStyles.rowMedia}>
      <img class={rowStyles.rowImage} src={image} alt={title} loading="lazy" />
    </div>
  ) : null}
</article>
