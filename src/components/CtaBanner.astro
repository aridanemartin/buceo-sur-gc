---
// src/components/CtaBanner.astro
// Big "RESERVA YA" booking banner, per the docx documents' "INSERTAR BOTON en grande RESERVA YA".
import styles from '../styles/viewCommon.module.css'

interface Props {
  href: string
  title: string
  text?: string
}

const { href, title, text } = Astro.props
---
<section class={styles.ctaBanner}>
  <div class={styles.ctaBannerInner}>
    <h2 class={styles.ctaTitle}>{title}</h2>
    {text && <p class={styles.ctaText}>{text}</p>}
    <a class={styles.ctaButton} href={href} target="_blank" rel="noopener noreferrer">RESERVA YA</a>
  </div>
</section>
