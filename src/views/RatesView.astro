---
import CtaBanner from '../components/CtaBanner.astro'
import PriceTable from '../components/PriceTable.astro'
import type { Locale } from '../i18n/locales'
// src/views/RatesView.astro
// Tarifas page — aggregates every price source (courses, experiences, tariff
// extras) into one consolidated pricing page, per docs/5. Tarifas.md:
// "todos los tarifas en la misma página con opciones y suplemento posible".
// The four groups sit behind category tabs and each PriceTable renders as a
// single-column card list — see PriceTable.astro for the per-row markup.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { resolveOgImage } from '../lib/seo'
import { getBaptisms, getCentroInfo, getCourses, getDives, getPageTexts, getTariffExtras, getUi } from '../sanity/queries'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const u = await getUi(lang)

const [bautizos, inmersiones, cursos, extras, centroInfo] = await Promise.all([
  getBaptisms(),
  getDives(),
  getCourses(),
  getTariffExtras(),
  getCentroInfo(),
])
const ogImage = resolveOgImage(centroInfo, 'rates')

const title = `${u.nav.rates} — ${SITE.fullName}`

const descriptions: Record<Locale, string> = {
  es: 'Todos los precios de bautizos, cursos, inmersiones y extras en un solo lugar.',
  en: 'All prices for discover dives, courses, guided dives and extras in one place.',
  fr: 'Tous les prix des baptêmes, formations, plongées et suppléments au même endroit.',
  de: 'Alle Preise für Schnuppertauchen, Kurse, Tauchgänge und Extras an einem Ort.',
}

const page = await getPageTexts('ratesPage', lang)

// Optional description under each category heading: one paragraph per line,
// nothing rendered when it is empty.
const paragraphsOf = (text: string): string[] =>
  text
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)

// Screen-reader-only label for the mobile category-tab group (the tabs
// themselves are visually hidden above 768px, where all four groups show
// at once instead).
const tabsLegend: Record<Locale, string> = {
  es: 'Filtrar tarifas por categoría',
  en: 'Filter rates by category',
  fr: 'Filtrer les tarifs par catégorie',
  de: 'Tarife nach Kategorie filtern',
}


const cols: Record<
  Locale,
  { product: string; price: string; includes: string; supplements: string; unit: string }
> = {
  es: {
    product: 'Producto',
    price: 'Precio',
    includes: 'Incluye',
    supplements: 'Suplemento / Opción',
    unit: 'Unidad',
  },
  en: {
    product: 'Product',
    price: 'Price',
    includes: 'Includes',
    supplements: 'Supplement / Option',
    unit: 'Unit',
  },
  fr: {
    product: 'Produit',
    price: 'Prix',
    includes: 'Inclut',
    supplements: 'Supplément / Option',
    unit: 'Unité',
  },
  de: {
    product: 'Produkt',
    price: 'Preis',
    includes: 'Inklusive',
    supplements: 'Zuschlag / Option',
    unit: 'Einheit',
  },
}
// "Requisitos" reuses the product-card label from Textos globales.
const col = { ...cols[lang], requirements: u.cardLabels.requirements }

const emDash = '—'
---

<BaseLayout lang={lang} path="rates" title={title} description={descriptions[lang]} ogImage={ogImage}>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{SITE.fullName}</p>
        <h1 class={styles.pageTitle}>{u.nav.rates}</h1>
        <p class={styles.pageSubtitle}>{page.subtitle}</p>
      </div>
    </header>

    <!-- Category tabs: the four <input>s below are driven by the labels in
         .ratesTabNav; :has() on .ratesTabsRoot then shows the matching
         .ratesPanel-*. Same layout at every width (see the <style> block). -->
    <div class="ratesTabsRoot">
      <fieldset class="ratesTabFieldset">
        <legend class="sr-only">{tabsLegend[lang]}</legend>
        <input type="radio" name="ratesTab" id="tab-bautizos" class="ratesTabInput" checked />
        <input type="radio" name="ratesTab" id="tab-inmersiones" class="ratesTabInput" />
        <input type="radio" name="ratesTab" id="tab-cursos" class="ratesTabInput" />
        <input type="radio" name="ratesTab" id="tab-extras" class="ratesTabInput" />
        <nav class="ratesTabNav">
          <label for="tab-bautizos">{u.nav.baptisms}</label>
          <label for="tab-inmersiones">{u.nav.dives}</label>
          <label for="tab-cursos">{u.nav.courses}</label>
          <label for="tab-extras">{page.extrasTitle}</label>
        </nav>
      </fieldset>

      <!-- Bautizos -->
      <section class={`${styles.section} ratesPanel ratesPanel-bautizos`}>
        <div class={styles.container}>
          <h2 class={`${styles.sectionTitle} ratesSectionTitle`}>{u.nav.baptisms}</h2>
          {paragraphsOf(page.baptismsDescription).length > 0 && (
            <div class="ratesSectionIntro">
              {paragraphsOf(page.baptismsDescription).map((p) => <p class={styles.bodyText}>{p}</p>)}
            </div>
          )}
          <div class={`${styles.card} pricingCard`}>
            <PriceTable lang={lang} col={col} emDash={emDash} items={bautizos} />
          </div>
        </div>
      </section>

      <!-- Inmersiones -->
      <section class={`${styles.sectionAlt} ratesPanel ratesPanel-inmersiones`}>
        <div class={styles.container}>
          <h2 class={`${styles.sectionTitle} ratesSectionTitle`}>{u.nav.dives}</h2>
          {paragraphsOf(page.divesDescription).length > 0 && (
            <div class="ratesSectionIntro">
              {paragraphsOf(page.divesDescription).map((p) => <p class={styles.bodyText}>{p}</p>)}
            </div>
          )}
          <div class={`${styles.card} pricingCard`}>
            <PriceTable lang={lang} col={col} emDash={emDash} items={inmersiones} />
          </div>
        </div>
      </section>

      <!-- Cursos -->
      <section class={`${styles.section} ratesPanel ratesPanel-cursos`}>
        <div class={styles.container}>
          <h2 class={`${styles.sectionTitle} ratesSectionTitle`}>{u.nav.courses}</h2>
          {paragraphsOf(page.coursesDescription).length > 0 && (
            <div class="ratesSectionIntro">
              {paragraphsOf(page.coursesDescription).map((p) => <p class={styles.bodyText}>{p}</p>)}
            </div>
          )}
          <div class={`${styles.card} pricingCard`}>
            <PriceTable lang={lang} col={col} emDash={emDash} items={cursos} />
          </div>
        </div>
      </section>

      <!-- Extras -->
      <section class={`${styles.sectionAlt} ratesPanel ratesPanel-extras`}>
        <div class={styles.container}>
          <h2 class={`${styles.sectionTitle} ratesSectionTitle`}>{page.extrasTitle}</h2>
          {paragraphsOf(page.extrasDescription).length > 0 && (
            <div class="ratesSectionIntro">
              {paragraphsOf(page.extrasDescription).map((p) => <p class={styles.bodyText}>{p}</p>)}
            </div>
          )}
          <div class={`${styles.card} pricingCard`}>
            <PriceTable lang={lang} col={col} emDash={emDash} variant="extras" items={extras} />
          </div>
        </div>
      </section>
    </div>

    <CtaBanner lang={lang} href={SITE.bookingUrlDives} title={page.ctaTitle} />
  </main>
</BaseLayout>

<style>
  /* Single reading column shared by the pills and every panel, so cards
     don't stretch across a wide screen. */
  .ratesTabsRoot {
    --rates-column: 720px;
  }

  .ratesPanel > div {
    max-width: var(--rates-column);
  }

  .pricingCard {
    padding: 20px 8px;
    overflow-x: auto;
  }

  .ratesSectionTitle {
    margin-bottom: 24px;
  }

  /* Category description: sits between the heading and the price table. */
  .ratesSectionIntro {
    max-width: 75ch;
    margin: -8px 0 24px;
  }

  .ratesSectionIntro p {
    margin: 0;
  }

  .ratesSectionIntro p + p {
    margin-top: 8px;
  }

  .ratesTabFieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .ratesTabInput {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ratesTabNav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 16px max(16px, calc((100% - var(--rates-column)) / 2));
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--color-white);
    border-bottom: 1px solid rgba(2, 62, 138, 0.08);
  }

  .ratesTabNav label {
    cursor: pointer;
    white-space: nowrap;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 100px;
    background: var(--color-ocean-50);
    color: var(--color-ocean-800);
    transition: background var(--transition), color var(--transition);
  }

  .ratesTabsRoot:has(#tab-bautizos:checked) .ratesTabNav label[for='tab-bautizos'],
  .ratesTabsRoot:has(#tab-inmersiones:checked) .ratesTabNav label[for='tab-inmersiones'],
  .ratesTabsRoot:has(#tab-cursos:checked) .ratesTabNav label[for='tab-cursos'],
  .ratesTabsRoot:has(#tab-extras:checked) .ratesTabNav label[for='tab-extras'] {
    background: var(--color-ocean-700);
    color: var(--color-white);
  }

  .ratesTabsRoot:has(#tab-bautizos:focus-visible) .ratesTabNav label[for='tab-bautizos'],
  .ratesTabsRoot:has(#tab-inmersiones:focus-visible) .ratesTabNav label[for='tab-inmersiones'],
  .ratesTabsRoot:has(#tab-cursos:focus-visible) .ratesTabNav label[for='tab-cursos'],
  .ratesTabsRoot:has(#tab-extras:focus-visible) .ratesTabNav label[for='tab-extras'] {
    outline: 2px solid var(--color-ocean-400);
    outline-offset: 2px;
  }

  /* Only the active category's <section> renders; the rest stay in the
     DOM (content is still crawlable/accessible) but visually hidden. */
  .ratesPanel {
    display: none;
  }

  .ratesTabsRoot:has(#tab-bautizos:checked) .ratesPanel-bautizos,
  .ratesTabsRoot:has(#tab-inmersiones:checked) .ratesPanel-inmersiones,
  .ratesTabsRoot:has(#tab-cursos:checked) .ratesPanel-cursos,
  .ratesTabsRoot:has(#tab-extras:checked) .ratesPanel-extras {
    display: block;
  }

  /* Cards carry their own surface, so drop the wrapping card at every width. */
  .ratesPanel .pricingCard {
    background: transparent;
    box-shadow: none;
    border: none;
    padding: 0;
    overflow: visible;
  }
</style>
