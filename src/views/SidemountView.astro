---
import CourseCard from '../components/CourseCard.astro'
import CtaBanner from '../components/CtaBanner.astro'
import PhotoCarousel from '../components/PhotoCarousel.tsx'
import { sidemountPageContent } from '../content/data/pageContent'
import { sidemountGalleryImages } from '../content/data/sidemountGallery'
import type { Locale } from '../i18n/locales'
import { localePath, withLangParam } from '../i18n/paths'
import { reserveInterestMessage, ui } from '../i18n/strings'
// src/views/SidemountView.astro
// Sidemount intro (canonical copy from src/content/data/pageContent.ts),
// the promo video, and the sidemount courses from their dedicated schema.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { resolveOgImage } from '../lib/seo'
import { t, tList, tSupplements } from '../sanity/localize'
import { getCentroInfo, getSidemountCourses } from '../sanity/queries'
import rowStyles from '../styles/rowLayout.module.css'
import textWithCarousel from '../styles/TextWithCarousel.module.css'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const u = ui[lang]
const courses = await getSidemountCourses()
const centroInfo = await getCentroInfo()
const ogImage = resolveOgImage(centroInfo, 'sidemount')

const l = (f: any) => t(f, lang)
const lList = (f: any) => tList(f, lang)
const lSupplements = (f: any) => tSupplements(f, lang)

// "Requisitos" heading for each course card's requirements block — matches
// the labels used on the Cursos page.
const requirementLabels: Record<Locale, string> = {
  es: 'Requisitos',
  en: 'Requirements',
  fr: 'Conditions',
  de: 'Voraussetzungen',
}[lang]

// Cards without a Bukyapp reservationLink fall back to the contact form
// with a prefilled "interested in X" message, opened in the same tab.
const reserveHrefOf = (c: any) =>
  c.reservationLink
    ? withLangParam(c.reservationLink, lang)
    : `${localePath(lang, 'contact')}?message=${encodeURIComponent(reserveInterestMessage(lang, l(c.title)))}`

const terrainImages = sidemountGalleryImages.map((url) => ({ url, alt: u.sidemount.alt }))

// Converts https://youtu.be/<id> or https://www.youtube.com/watch?v=<id>
// into a privacy-enhanced youtube-nocookie embed URL that autoplays once
// ready. `mute=1` is required for browsers to allow autoplay at all, and
// `controls=0` hides the player chrome for a clean, silent background video.
function toEmbedUrl(url: string): string {
  const match = url.match(/(?:youtu\.be\/|watch\?v=)([\w-]{6,})/)
  return match ? `https://www.youtube-nocookie.com/embed/${match[1]}?autoplay=1&mute=1&controls=0` : url
}

const videoEmbedUrl = toEmbedUrl(sidemountPageContent.videoUrl)

const cta = {
  es: {
    title: 'Reserva tu bautismo Sidemount',
  },
  en: {
    title: 'Book your Sidemount discover dive',
  },
  fr: {
    title: 'Réservez votre baptême Sidemount',
  },
  de: {
    title: 'Buchen Sie Ihr Sidemount-Schnuppertauchen',
  },
}[lang]
---
<BaseLayout
  lang={lang}
  path="sidemount"
  title={l(sidemountPageContent.introTitle)}
  description={l(sidemountPageContent.intro)}
  ogImage={ogImage}
>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>Sidemount</p>
        <h1 class={styles.pageTitle}>{l(sidemountPageContent.introTitle)}</h1>
        <p class={styles.pageSubtitle}>{l(sidemountPageContent.motto)}</p>
      </div>
    </header>

    <section class={styles.section}>
      <div class={`${styles.container} sidemount-body`}>
        <div class={textWithCarousel.grid}>
          <div class={textWithCarousel.text}>
            <h2 class={styles.sectionTitle}>{u.nav.sidemount}</h2>
            <p class={styles.bodyText}>{l(sidemountPageContent.intro)}</p>
          </div>
          <div class={styles.videoWrapper}>
            <iframe
              src={videoEmbedUrl}
              title={l(sidemountPageContent.introTitle)}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowFullScreen
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class={styles.sectionAlt}>
      <div class={`${styles.container} sidemount-body`}>
        <p class={styles.sectionEyebrow}>Sidemount</p>
        <div class={textWithCarousel.grid}>
          <div class={textWithCarousel.text}>
            <h2 class={styles.sectionTitle}>{l(sidemountPageContent.terrainTitle)}</h2>
            <p class={styles.bodyText}>{l(sidemountPageContent.terrain)}</p>
          </div>
          <PhotoCarousel
            images={terrainImages}
            prevLabel={u.sidemount.prev}
            nextLabel={u.sidemount.next}
            client:load
          />
        </div>
      </div>
    </section>

    <section class={styles.section} id="cursos">
      <div class={`${styles.container} sidemount-body`}>
        <p class={styles.sectionEyebrow}>{u.nav.courses}</p>
        <h2 class={styles.sectionTitle}>{l(sidemountPageContent.courseTitle)}</h2>
        <ul class={styles.list}>
          <li>{l(sidemountPageContent.courseRequirementsTitle)}: {l(sidemountPageContent.courseRequirements)}</li>
          <li>{l(sidemountPageContent.courseIncludesTitle)}: {l(sidemountPageContent.courseIncludes)}</li>
        </ul>

        <div class={rowStyles.list}>
          {courses.map((c: any) => (
            <CourseCard
              title={l(c.title)}
              meta={[
                c.agency,
                c.depthLimit ? `${c.depthLimit} m` : '',
                l(c.duration),
                c.minAge ? `${c.minAge}+` : '',
              ].filter((v) => v)}
              paragraphs={[
                { text: l(c.summary) },
                { items: lList(c.includes) },
                ...(lSupplements(c.supplements).length
                  ? [{ supplements: lSupplements(c.supplements) }]
                  : []),
                { label: requirementLabels, requirements: lList(c.requirements) },
              ]}
              price={c.price ? `${c.price} €` : null}
              image={c.image || null}
              reserveHref={reserveHrefOf(c)}
              reserveLabel={u.book}
              reserveExternal={!!c.reservationLink}
            />
          ))}
        </div>
      </div>
    </section>

    <CtaBanner lang={lang} href={SITE.bookingUrl} title={cta.title} />
  </main>
</BaseLayout>

<style>
  .sidemount-body {
    max-width: 1000px;
    margin: 0 auto;
  }
</style>
