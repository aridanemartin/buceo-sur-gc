---
import CourseCard from '../components/CourseCard.astro'
import CtaBanner from '../components/CtaBanner.astro'
import PhotoCarousel from '../components/PhotoCarousel.tsx'
import type { Locale } from '../i18n/locales'
import { withLangParam } from '../i18n/paths'
import { reserveInterestMailtoFrom } from '../i18n/strings'
// src/views/SidemountView.astro
// Sidemount intro (texts from the sidemountPage singleton),
// the promo video, and the sidemount courses from their dedicated schema.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { resolveOgImage } from '../lib/seo'
import { toYoutubeEmbedUrl } from '../lib/youtube'
import { t, tList, tSupplements } from '../sanity/localize'
import { getCentroInfo, getPageTexts, getSidemountCourses, getUi } from '../sanity/queries'
import rowStyles from '../styles/rowLayout.module.css'
import textWithCarousel from '../styles/TextWithCarousel.module.css'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const u = await getUi(lang)
const page = await getPageTexts('sidemountPage', lang)
// The text + media blocks (Studio: "Secciones"), looked up by their fixed key.
const sec = Object.fromEntries(page.sections.map((s) => [s.key, s]))
const courses = await getSidemountCourses()
const centroInfo = await getCentroInfo()
const ogImage = resolveOgImage(centroInfo, 'sidemount')

const l = (f: any) => t(f, lang)
const lList = (f: any) => tList(f, lang)
const lSupplements = (f: any) => tSupplements(f, lang)

// Cards without a Bukyapp reservationLink fall back to a mailto: with a
// prefilled "interested in X" subject and body.
const reserveHrefOf = (c: any) =>
  c.reservationLink ? withLangParam(c.reservationLink, lang) : reserveInterestMailtoFrom(u, l(c.title))

const terrainImages = sec.terrain.images.map((url) => ({ url, alt: u.sidemount.alt }))

// Converts https://youtu.be/<id> or https://www.youtube.com/watch?v=<id>
// into a privacy-enhanced youtube-nocookie embed URL that autoplays once
// ready. `mute=1` is required for browsers to allow autoplay at all, and
// `controls=0` hides the player chrome for a clean, silent background video.
const videoEmbedUrl =
  toYoutubeEmbedUrl(sec.intro.videoUrl, {
    autoplay: '1',
    mute: '1',
    controls: '0',
  }) ?? sec.intro.videoUrl
---
<BaseLayout
  lang={lang}
  path="sidemount"
  title={page.introTitle}
  description={sec.intro.body}
  ogImage={ogImage}
>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{page.eyebrow}</p>
        <h1 class={styles.pageTitle}>{page.introTitle}</h1>
        <p class={styles.pageSubtitle}>{page.motto}</p>
      </div>
    </header>

    <section class={styles.section}>
      <div class={`${styles.container} sidemount-body`}>
        <div class={textWithCarousel.grid}>
          <div class={textWithCarousel.text}>
            <h2 class={styles.sectionTitle}>{sec.intro.title}</h2>
            <p class={styles.bodyText}>{sec.intro.body}</p>
          </div>
          <div class={styles.videoWrapper}>
            <iframe
              src={videoEmbedUrl}
              title={page.introTitle}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowFullScreen
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class={styles.sectionAlt}>
      <div class={`${styles.container} sidemount-body`}>
        <p class={styles.sectionEyebrow}>{sec.terrain.eyebrow}</p>
        <div class={textWithCarousel.grid}>
          <div class={textWithCarousel.text}>
            <h2 class={styles.sectionTitle}>{sec.terrain.title}</h2>
            <p class={styles.bodyText}>{sec.terrain.body}</p>
          </div>
          <PhotoCarousel
            images={terrainImages}
            prevLabel={u.sidemount.prev}
            nextLabel={u.sidemount.next}
            client:load
          />
        </div>
      </div>
    </section>

    <section class={styles.section} id="cursos">
      <div class={`${styles.container} sidemount-body`}>
        <p class={styles.sectionEyebrow}>{u.nav.courses}</p>
        <h2 class={styles.sectionTitle}>{page.courseTitle}</h2>
        <ul class={styles.list}>
          <li>{page.courseRequirementsTitle}: {page.courseRequirements}</li>
          <li>{page.courseIncludesTitle}: {page.courseIncludes}</li>
        </ul>

        <div class={rowStyles.list}>
          {courses.map((c: any) => (
            <CourseCard
              title={l(c.title)}
              meta={[
                c.agency,
                c.depthLimit ? `${c.depthLimit} m` : '',
                l(c.duration),
                c.minAge ? `${c.minAge}+` : '',
              ].filter((v) => v)}
              paragraphs={[
                { text: l(c.summary) },
                { items: lList(c.includes) },
                ...(lSupplements(c.supplements).length
                  ? [{ supplements: lSupplements(c.supplements) }]
                  : []),
                { label: u.cardLabels.requirements, requirements: lList(c.requirements) },
              ]}
              price={c.price ? `${c.price} €` : null}
              image={c.image || null}
              reserveHref={reserveHrefOf(c)}
              reserveLabel={u.book}
              reserveExternal={!!c.reservationLink}
            />
          ))}
        </div>
      </div>
    </section>

    <CtaBanner lang={lang} href={SITE.bookingUrl} title={page.ctaTitle} />
  </main>
</BaseLayout>

<style>
  .sidemount-body {
    max-width: 1000px;
    margin: 0 auto;
  }
</style>
