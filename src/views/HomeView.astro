---
import CtaBanner from "../components/CtaBanner.astro";
import heroStyles from "../components/Hero.module.css";
import PhotoCarousel from "../components/PhotoCarousel.tsx";
import WildlifeMarquee from "../components/WildlifeMarquee.astro";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/strings";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/constants";
import { t } from "../sanity/localize";
import { getCentroInfo } from "../sanity/queries";
import aboutStyles from "../styles/HomeAbout.module.css";
import dondeEstamos from "../styles/HomeDondeEstamos.module.css";
import instalaciones from "../styles/HomeInstalaciones.module.css";
import commonStyles from "../styles/viewCommon.module.css";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const info = await getCentroInfo();
const l = (f: any) => t(f, lang);
const uiStrings = ui[lang];
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(
  `Buceo Sur Gran Canaria, ${SITE.address.line1}, ${SITE.address.line2}, ${SITE.address.line3}`,
)}&z=15&output=embed&hl=${lang}`;
const instalacionesImages = (info?.installationsImages ?? []).map(
  (url: string) => ({
    url,
    alt: uiStrings.home.facilitiesAlt,
  }),
);
---

<BaseLayout
  lang={lang}
  path=""
  title={uiStrings.home.metaTitle}
  description={l(info?.intro)}
>
  <main>
    <section
      id="inicio"
      class={heroStyles.hero}
      aria-label={uiStrings.home.heroLabel}
    >
      <div class={heroStyles.vignette}></div>
      <img
        src="/logo.png"
        alt="Buceo Sur Gran Canaria"
        class={heroStyles.logo}
        width={480}
        height={186}
      />
      <a
        href="#nosotros"
        class={heroStyles.scroll}
        aria-label={uiStrings.home.scrollLabel}
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </section>

    <section id="nosotros" class={aboutStyles.section}>
      <div class={aboutStyles.container}>
        <div class={aboutStyles.text}>
          <p class={aboutStyles.eyebrow}>{uiStrings.home.whoWeAreEyebrow}</p>
          <h2 class={aboutStyles.title}>Buceo Sur Gran Canaria</h2>
          <p class={aboutStyles.body}>{l(info?.intro)}</p>
          <p class={aboutStyles.body}>{l(info?.history)}</p>

          <ul
            class={aboutStyles.certifications}
            aria-label={uiStrings.home.certificationsLabel}
          >
            {
              (info?.certifications ?? []).map((cert: any) => (
                <li class={aboutStyles.cert}>
                  {cert.logo ? (
                    <img
                      class={aboutStyles.certLogo}
                      src={cert.logo}
                      alt={cert.name}
                    />
                  ) : (
                    cert.name
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <div class={aboutStyles.video}>
          <div class={aboutStyles.videoWrapper}>
            <iframe
              src="https://www.youtube-nocookie.com/embed/3ZaJwr3My3Y?wmode=transparent&vq=hd1080"
              title={uiStrings.home.videoTitle}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allow-fullScreen
              loading="lazy"></iframe>
          </div>
          <p class={aboutStyles.videoCaption}>
            {uiStrings.home.videoCaption}
          </p>
        </div>
      </div>
    </section>

    <WildlifeMarquee lang={lang} />

    <section id="instalaciones" class={commonStyles.sectionAlt}>
      <div class={commonStyles.container}>
        <p class={commonStyles.sectionEyebrow}>
          {uiStrings.home.facilitiesEyebrow}
        </p>

        <div class={instalaciones.grid}>
          <div class={instalaciones.text}>
            <h2 class={commonStyles.sectionTitle}>
              {uiStrings.home.facilitiesTitle}
            </h2>
            <p class={commonStyles.bodyText}>{l(info?.installations)}</p>
          </div>
          {
            instalacionesImages.length > 0 && (
              <PhotoCarousel
                images={instalacionesImages}
                prevLabel={uiStrings.home.facilitiesPrev}
                nextLabel={uiStrings.home.facilitiesNext}
                client:load
              />
            )
          }
        </div>
      </div>
    </section>

    <section id="equipo" class={commonStyles.section}>
      <div class={commonStyles.container}>
        <p class={commonStyles.sectionEyebrow}>{uiStrings.home.aboutEyebrow}</p>
        <h2 class={commonStyles.sectionTitle}>{uiStrings.home.teamTitle}</h2>
        <div class={commonStyles.grid}>
          {
            (info?.staff ?? []).map((member: any) => (
              <article class={commonStyles.card}>
                {member.photo && (
                  <img
                    src={member.photo}
                    alt={member.name}
                    width={96}
                    height={96}
                    style="border-radius:50%; object-fit:cover; width:96px; height:96px;"
                  />
                )}
                <h3 class={commonStyles.cardTitle}>{member.name}</h3>
                <ul class={commonStyles.cardMeta}>
                  <li>{l(member.role)}</li>
                  <li>{l(member.languages)}</li>
                </ul>
                <p class={commonStyles.cardBody}>{l(member.bio)}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class={aboutStyles.section} aria-label={uiStrings.home.statsLabel}>
      <div class={aboutStyles.stats}>
        {
          (info?.stats ?? []).map((stat: any) => (
            <div class={aboutStyles.stat}>
              <span class={aboutStyles.statValue}>{stat.value}</span>
              <span class={aboutStyles.statLabel}>{l(stat.label)}</span>
            </div>
          ))
        }
      </div>
    </section>

    <CtaBanner
      lang={lang}
      href={SITE.bookingUrl}
      title={uiStrings.home.ctaTitle}
      text={uiStrings.home.ctaText}
    />

    <section id="donde-estamos" class={commonStyles.section}>
      <div class={commonStyles.container}>
        <h2 class={commonStyles.sectionTitle}>{uiStrings.home.dondeEstamos}</h2>
        <div class={dondeEstamos.mapWrapper}>
          <iframe
            src={mapSrc}
            title={`Buceo Sur Gran Canaria — ${uiStrings.home.dondeEstamos}`}
            width="100%"
            height="400"
            loading="lazy"
            allow-fullScreen
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
