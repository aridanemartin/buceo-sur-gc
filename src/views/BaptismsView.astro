---
import CourseCard from '../components/CourseCard.astro'
import CtaBanner from '../components/CtaBanner.astro'
import type { Locale } from '../i18n/locales'
import { withLangParam } from '../i18n/paths'
import { reserveInterestMailtoFrom } from '../i18n/strings'
// src/views/BaptismsView.astro
// Bautizos page — intro prose from the baptismsPage singleton plus the beginner
// experiences as cards with their YouTube video, per docs/3. Bautizos.md.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { resolveOgImage } from '../lib/seo'
import { t, tList, tSupplements } from '../sanity/localize'
import { getBaptisms, getCentroInfo, getPageTexts, getUi } from '../sanity/queries'
import rowStyles from '../styles/rowLayout.module.css'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const u = await getUi(lang)

const experiences = await getBaptisms()
const centroInfo = await getCentroInfo()
const ogImage = resolveOgImage(centroInfo, 'baptisms')

const page = await getPageTexts('baptismsPage', lang)
const l = u.cardLabels

const descriptions: Record<Locale, string> = {
  es: 'Bautizos de buceo para principiantes sin certificación en Gran Canaria: dos tipos de iniciación con instructor.',
  en: 'Discover scuba diving for beginners without certification in Gran Canaria: two initiation options with an instructor.',
  fr: 'Baptêmes de plongée pour débutants sans certification à Grande Canarie : deux types d’initiation avec instructeur.',
  de: 'Schnuppertauchen für Anfänger ohne Zertifizierung auf Gran Canaria: zwei Einführungsoptionen mit Ausbilder.',
}

// Converts youtu.be / youtube.com watch or embed links into privacy-enhanced
// youtube-nocookie embeds with the player chrome hidden. Deliberately NOT
// autoplayed: this page lists several videos and loading them all at once
// would be heavy — the user clicks the placeholder to play each one.
// https://www.youtube-nocookie.com/embed/VIDEO_ID?controls=0
// (The shared CourseCard component does this conversion for the cards.)
const depthBadge = (n: number | null | undefined): string => (n ? `${l.depth} ${n} m` : '')
const priceOf = (x: { price?: number | null }): string => (x.price ? `${x.price} €` : '')

// Cards without a Bukyapp reservationLink fall back to a mailto: with a
// prefilled "interested in X" subject and body.
const reserveHrefOf = (x: any) =>
  x.reservationLink
    ? withLangParam(x.reservationLink, lang)
    : reserveInterestMailtoFrom(u, t(x.title, lang))
---

<BaseLayout
  lang={lang}
  path="baptisms"
  title={`${u.nav.baptisms} — ${SITE.fullName}`}
  description={descriptions[lang]}
  ogImage={ogImage}
>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{SITE.fullName}</p>
        <h1 class={styles.pageTitle}>
          {page.introTitle}
        </h1>
        <p class={styles.pageSubtitle}>{page.intro}</p>
      </div>
    </header>

    <!-- Beginner experiences -->
    <section class={styles.section}>
      <div class={styles.container}>
        <div class={rowStyles.list}>
          {experiences.map((x: any) => (
            <CourseCard
              title={t(x.title, lang)}
              meta={[t(x.duration, lang), depthBadge(x.depthLimit)].filter((v) => v)}
              paragraphs={[
                { text: t(x.description, lang) },
                ...(tList(x.includes, lang).length
                  ? [{ label: l.includes, items: tList(x.includes, lang) }]
                  : []),
                ...(tSupplements(x.supplements, lang).length
                  ? [{ label: l.supplements, supplements: tSupplements(x.supplements, lang) }]
                  : []),
                ...(tList(x.requirements, lang).length
                  ? [{ label: l.requirements, requirements: tList(x.requirements, lang) }]
                  : []),
              ]}
              price={priceOf(x) || null}
              image={x.image || null}
              videoUrl={x.videoUrl || null}
              reserveHref={reserveHrefOf(x)}
              reserveLabel={u.book}
              reserveExternal={!!x.reservationLink}
            />
          ))}
        </div>
      </div>
    </section>

    <CtaBanner
      lang={lang}
      href={SITE.bookingUrl}
      title={page.ctaTitle}
    />
  </main>
</BaseLayout>
