---
import CourseCard from "../components/CourseCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import type { Locale } from "../i18n/locales";
// src/views/CoursesView.astro
// Renders all course documents from getCourses(), ordered by category
// (recreational / specialty / technical) with a client-filterable,
// multi-select toggle for that same category. Agencies are no longer
// split into separate sections — each course row already carries its own
// agency logo via CourseCard.
import { withLangParam } from "../i18n/paths";
import { reserveInterestMailtoFrom } from "../i18n/strings";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/constants";
import { resolveOgImage } from "../lib/seo";
import { t, tList, tSupplements } from "../sanity/localize";
import { fillTemplate } from "../sanity/pageTexts";
import { getCentroInfo, getCertifyingAgencies, getCourses, getPageTexts, getUi } from "../sanity/queries";
import filterStyles from "../styles/coursesFilter.module.css";
import rowStyles from "../styles/rowLayout.module.css";
import styles from "../styles/viewCommon.module.css";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const u = await getUi(lang);
const courses = await getCourses();
const centroInfo = await getCentroInfo();
const ogImage = resolveOgImage(centroInfo, "courses");

// Cards without a Bukyapp reservationLink fall back to a mailto: with a
// prefilled "interested in X" subject and body.
const reserveHrefOf = (c: any) =>
  c.reservationLink
    ? withLangParam(c.reservationLink, lang)
    : reserveInterestMailtoFrom(u, l(c.title));
const agencies = await getCertifyingAgencies();
const agencyByName = new Map(agencies.map((a: any) => [a.name, a]));

const l = (f: any) => t(f, lang);
const lList = (f: any) => tList(f, lang);
const lSupplements = (f: any) => tSupplements(f, lang);

const agencyNames = [...new Set(courses.map((c: any) => c.agency))];
const agencyList = agencyNames.length
  ? new Intl.ListFormat(lang, { style: "long", type: "conjunction" }).format(
      agencyNames,
    )
  : "";

const texts = await getPageTexts("coursesPage", lang);

// Title and subtitle come from the coursesPage singleton; the subtitle
// template's {agencies} placeholder is filled with the agency list.
const page = {
  title: texts.title,
  description: agencyList
    ? fillTemplate(texts.subtitle, { agencies: agencyList })
    : texts.subtitleNoAgencies,
};

const labels = u.cardLabels;

const categoryLabels: Record<string, string> = texts.categoryLabels;

// Accessible name of the pill group; the pills themselves carry the labels.
const filterCopy = {
  es: { label: "Filtrar por modalidad" },
  en: { label: "Filter by type" },
  fr: { label: "Filtrer par type" },
  de: { label: "Nach Kursart filtern" },
}[lang];

// The page splits courses into two audiences: beginners and advanced.
// Each section has its own pill, a title (icon + rule, same as the old
// per-category headings), an informational description and its cards. The
// advanced section merges the specialty and technical tracks; every card
// still carries its own track badge.
const sectionDefinitions = [
  {
    key: "beginners",
    tone: "recreational",
    icon: "/assets/icons/recreational.webp",
    categories: ["recreational"],
    label: texts.beginnersTitle,
    note: { paragraphs: texts.introParagraphs },
  },
  {
    key: "advanced",
    tone: "specialty",
    icon: "/assets/icons/specialty.webp",
    categories: ["specialty", "technical"],
    label: texts.advancedTitle,
    note: { paragraphs: texts.specialtyParagraphs, lead: true },
  },
];

// Courses arrive from getCourses() already sorted by their Sanity `order`;
// filtering into sections keeps that relative order within each one.
const sections = sectionDefinitions
  .map((section) => ({
    ...section,
    items: courses.filter((c: any) => section.categories.includes(c.category)),
  }))
  .filter((section) => section.items.length > 0);

// No "all" option: the pills reveal one section at a time, so the first
// available section is selected on load.
const defaultSection = sections[0]?.key ?? "beginners";
---

<BaseLayout
  lang={lang}
  path="courses"
  title={page.title}
  description={page.description}
  ogImage={ogImage}
>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{agencyNames.join(" · ")}</p>
        <h1 class={styles.pageTitle}>{page.title}</h1>
        <p class={styles.pageSubtitle}>{page.description}</p>
      </div>
    </header>

    <section class={styles.section}>
      <div class={styles.container}>
        <fieldset class={filterStyles.pillBar}>
          <legend class={filterStyles.srOnly}>{filterCopy.label}</legend>
          {
            sections.map((section) => (
              <label class={filterStyles.filterChip} data-tone={section.tone}>
                <input
                  type="radio"
                  name="section"
                  value={section.key}
                  checked={section.key === defaultSection}
                />
                <span
                  class={filterStyles.filterChipIcon}
                  style={`--icon: url(${section.icon})`}
                  aria-hidden="true"
                />
                {section.label}
              </label>
            ))
          }
        </fieldset>

        <div class={filterStyles.courseGroups}>
          {
            sections.map((section) => (
              <section
                class={filterStyles.categoryGroup}
                data-section={section.key}
              >
                <h2
                  class={filterStyles.categoryHeading}
                  data-tone={section.tone}
                >
                  <span
                    class={filterStyles.categoryHeadingIcon}
                    style={`--icon: url(${section.icon})`}
                    aria-hidden="true"
                  />
                  {section.label}
                </h2>
                <div class={filterStyles.sectionNote}>
                  {section.note.paragraphs.map((paragraph, index) => (
                    <p
                      class={
                        index === 0 && section.note.lead
                          ? filterStyles.sectionNoteLead
                          : undefined
                      }
                    >
                      {paragraph}
                    </p>
                  ))}
                </div>
                <div class={`${rowStyles.list} ${filterStyles.courseList}`}>
                  {section.items.map((c: any) => (
                    <CourseCard
                      title={l(c.title)}
                      category={{
                        key: c.category,
                        label: categoryLabels[c.category],
                      }}
                      agencyLogo={agencyByName.get(c.agency)?.logo ?? null}
                      agencyName={c.agency}
                      meta={[
                        c.depthLimit ? `${c.depthLimit} m` : "",
                        l(c.duration),
                        c.minAge ? `${c.minAge}+` : "",
                      ].filter((v) => v)}
                      paragraphs={[
                        { text: l(c.summary) },
                        { label: labels.includes, items: lList(c.includes) },
                        ...(lSupplements(c.supplements).length
                          ? [{ label: labels.supplements, supplements: lSupplements(c.supplements) }]
                          : []),
                        { label: labels.requirements, requirements: lList(c.requirements) },
                      ]}
                      price={c.price ? `${c.price} €` : null}
                      image={c.image || null}
                      videoUrl={c.videoUrl || null}
                      headingLevel={3}
                      reserveHref={reserveHrefOf(c)}
                      reserveLabel={u.book}
                      reserveExternal={!!c.reservationLink}
                    />
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBanner lang={lang} href={SITE.bookingUrlDives} title={texts.ctaTitle} />
  </main>
</BaseLayout>
