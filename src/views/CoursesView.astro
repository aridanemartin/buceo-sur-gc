---
import CourseCard from "../components/CourseCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import type { Locale } from "../i18n/locales";
// src/views/CoursesView.astro
// Renders all course documents from getCourses(), ordered by category
// (recreational / specialty / technical) with a client-filterable,
// multi-select toggle for that same category. Agencies are no longer
// split into separate sections — each course row already carries its own
// agency logo via CourseCard.
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/constants";
import { t } from "../sanity/localize";
import { getCertifyingAgencies, getCourses } from "../sanity/queries";
import filterStyles from "../styles/coursesFilter.module.css";
import rowStyles from "../styles/rowLayout.module.css";
import styles from "../styles/viewCommon.module.css";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const courses = await getCourses();
const agencies = await getCertifyingAgencies();
const agencyByName = new Map(agencies.map((a: any) => [a.name, a]));

const l = (f: any) => t(f, lang);

const agencyNames = [...new Set(courses.map((c: any) => c.agency))];
const agencyList = agencyNames.length
  ? new Intl.ListFormat(lang, { style: "long", type: "conjunction" }).format(
      agencyNames,
    )
  : "";

const page = {
  es: {
    title: "Cursos de buceo",
    description: agencyList
      ? `Cursos ${agencyList} para todos los niveles en Gran Canaria.`
      : "Cursos de buceo para todos los niveles en Gran Canaria.",
  },
  en: {
    title: "Diving courses",
    description: agencyList
      ? `${agencyList} courses for all levels in Gran Canaria.`
      : "Diving courses for all levels in Gran Canaria.",
  },
  fr: {
    title: "Formations de plongée",
    description: agencyList
      ? `Formations ${agencyList} pour tous les niveaux à Grande Canarie.`
      : "Formations de plongée pour tous les niveaux à Grande Canarie.",
  },
  de: {
    title: "Tauchkurse",
    description: agencyList
      ? `${agencyList} Kurse für alle Level auf Gran Canaria.`
      : "Tauchkurse für alle Level auf Gran Canaria.",
  },
}[lang];

const categoryLabels: Record<string, string> = {
  es: {
    recreational: "Recreativo",
    specialty: "Especialidad",
    technical: "Técnico",
  },
  en: {
    recreational: "Recreational",
    specialty: "Specialty",
    technical: "Technical",
  },
  fr: {
    recreational: "Loisirs",
    specialty: "Spécialité",
    technical: "Technique",
  },
  de: {
    recreational: "Freizeit",
    specialty: "Spezialkurs",
    technical: "Technisch",
  },
}[lang];

const filterCopy = {
  es: {
    label: "Filtrar por modalidad",
    all: "Todos",
  },
  en: {
    label: "Filter by type",
    all: "All",
  },
  fr: {
    label: "Filtrer par type",
    all: "Tous",
  },
  de: {
    label: "Nach Kursart filtern",
    all: "Alle",
  },
}[lang];

const cta = {
  es: {
    title: "Reserva tu curso de buceo",
  },
  en: {
    title: "Book your diving course",
  },
  fr: {
    title: "Réservez votre formation de plongée",
  },
  de: {
    title: "Buchen Sie Ihren Tauchkurs",
  },
}[lang];

// Fixed taxonomy, shallow to deep — matches the depth-scale badge colors
// used on each CourseCard (light → mid → dark blue).
const categoryOrder = ["recreational", "specialty", "technical"] as const;

const categoryIcon: Record<string, string> = {
  recreational: "/assets/icons/recreational.webp",
  specialty: "/assets/icons/specialty.webp",
  technical: "/assets/icons/technical.webp",
};

const categoryVariant: Record<string, string> = {
  recreational: filterStyles.filterChipRecreational,
  specialty: filterStyles.filterChipSpecialty,
  technical: filterStyles.filterChipTechnical,
};

// Courses arrive from getCourses() already sorted by their Sanity `order`.
// Grouping by category (instead of by agency) reorders the page while
// keeping that relative order intact within each group.
const categorized = categoryOrder
  .map((category) => ({
    category,
    label: categoryLabels[category],
    items: courses.filter((c: any) => c.category === category),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  lang={lang}
  path="courses"
  title={page.title}
  description={page.description}
>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{agencyNames.join(" · ")}</p>
        <h1 class={styles.pageTitle}>{page.title}</h1>
        <p class={styles.pageSubtitle}>{page.description}</p>
      </div>
    </header>

    <section class={styles.section}>
      <div class={styles.container}>
        <fieldset class={filterStyles.filterBar}>
          <legend class={filterStyles.filterLabel}>{filterCopy.label}</legend>
          <label class={`${filterStyles.filterChip} ${filterStyles.filterChipAll}`}>
            <input type="radio" name="category" value="all" checked />
            {filterCopy.all}
          </label>
          {
            categorized.map((group) => (
              <label
                class={`${filterStyles.filterChip} ${categoryVariant[group.category]}`}
              >
                <input type="radio" name="category" value={group.category} />
                <span
                  class={filterStyles.filterChipIcon}
                  style={`--icon: url(${categoryIcon[group.category]})`}
                  aria-hidden="true"
                />
                {group.label}
              </label>
            ))
          }
        </fieldset>

        <div class={filterStyles.courseGroups}>
          {
            categorized.map((group) => (
              <section
                class={filterStyles.categoryGroup}
                data-category={group.category}
              >
                <h2
                  class={filterStyles.categoryHeading}
                  data-tone={group.category}
                >
                  <span
                    class={filterStyles.categoryHeadingIcon}
                    style={`--icon: url(${categoryIcon[group.category]})`}
                    aria-hidden="true"
                  />
                  {group.label}
                </h2>
                <div class={rowStyles.list}>
                  {group.items.map((c: any) => (
                    <CourseCard
                      title={l(c.title)}
                      category={{
                        key: group.category,
                        label: group.label,
                      }}
                      agencyLogo={agencyByName.get(c.agency)?.logo ?? null}
                      agencyName={c.agency}
                      meta={[
                        c.depthLimit ? `${c.depthLimit} m` : "",
                        l(c.duration),
                        c.minAge ? `${c.minAge}+` : "",
                      ].filter((v) => v)}
                      paragraphs={[
                        { text: l(c.summary) },
                        { text: l(c.includes) },
                        ...(l(c.supplements)
                          ? [{ text: l(c.supplements) }]
                          : []),
                        { text: l(c.prerequisites) },
                      ]}
                      price={c.price ? `${c.price} €` : null}
                      image={c.image || null}
                      headingLevel={3}
                    />
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBanner lang={lang} href={SITE.bookingUrlDives} title={cta.title} />
  </main>
</BaseLayout>
