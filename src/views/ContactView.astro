---
import ContactForm from '../components/ContactForm'
import CtaBanner from '../components/CtaBanner.astro'
// src/views/ContactView.astro
// Contacto page: contact details from SITE constants, social links, and the
// ContactForm React island (client-side submitted-state only, no backend).
import type { Locale } from '../i18n/locales'
import { SITE } from '../lib/constants'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props

const t = {
  es: {
    eyebrow: 'Contacto',
    title: 'Ponte en contacto con nosotros',
    subtitle:
      '¿Tienes alguna duda sobre inmersiones, bautizos o cursos? Escríbenos o llámanos, estaremos encantados de ayudarte.',
    contactTitle: 'Información de contacto',
    emailLabel: 'Email',
    phonesLabel: 'Teléfonos',
    addressLabel: 'Dirección',
    socialTitle: 'Síguenos',
    formTitle: 'Envíanos un mensaje',
    formNote: `También puedes escribirnos directamente a ${SITE.email}.`,
    form: {
      name: 'Nombre',
      email: 'Tu email',
      message: 'Mensaje',
      submit: 'Enviar',
      successTitle: '¡Gracias por tu mensaje!',
      successText:
        'Hemos recibido tu mensaje y te responderemos lo antes posible. Para reservas, puedes escribirnos directamente por email o teléfono.',
    },
  },
  en: {
    eyebrow: 'Contact',
    title: 'Get in touch with us',
    subtitle:
      'Any questions about dives, discover scuba diving or courses? Write to us or call us — we will be happy to help.',
    contactTitle: 'Contact information',
    emailLabel: 'Email',
    phonesLabel: 'Phones',
    addressLabel: 'Address',
    socialTitle: 'Follow us',
    formTitle: 'Send us a message',
    formNote: `You can also write to us directly at ${SITE.email}.`,
    form: {
      name: 'Name',
      email: 'Your email',
      message: 'Message',
      submit: 'Send',
      successTitle: 'Thank you for your message!',
      successText:
        'We have received your message and will get back to you as soon as possible. For bookings, feel free to contact us directly by email or phone.',
    },
  },
  fr: {
    eyebrow: 'Contact',
    title: 'Contactez-nous',
    subtitle:
      'Une question sur les plongées, les baptêmes ou les formations ? Écrivez-nous ou appelez-nous, nous serons ravis de vous aider.',
    contactTitle: 'Coordonnées',
    emailLabel: 'E-mail',
    phonesLabel: 'Téléphones',
    addressLabel: 'Adresse',
    socialTitle: 'Suivez-nous',
    formTitle: 'Envoyez-nous un message',
    formNote: `Vous pouvez également nous écrire directement à ${SITE.email}.`,
    form: {
      name: 'Nom',
      email: 'Votre e-mail',
      message: 'Message',
      submit: 'Envoyer',
      successTitle: 'Merci pour votre message !',
      successText:
        'Nous avons bien reçu votre message et vous répondrons dès que possible. Pour les réservations, n’hésitez pas à nous contacter directement par e-mail ou par téléphone.',
    },
  },
  de: {
    eyebrow: 'Kontakt',
    title: 'Kontaktieren Sie uns',
    subtitle:
      'Fragen zu Tauchgängen, Schnuppertauchen oder Kursen? Schreiben Sie uns oder rufen Sie uns an – wir helfen Ihnen gerne.',
    contactTitle: 'Kontaktinformationen',
    emailLabel: 'E-Mail',
    phonesLabel: 'Telefon',
    addressLabel: 'Adresse',
    socialTitle: 'Folgen Sie uns',
    formTitle: 'Schreiben Sie uns',
    formNote: `Sie können uns auch direkt schreiben an ${SITE.email}.`,
    form: {
      name: 'Name',
      email: 'Ihre E-Mail',
      message: 'Nachricht',
      submit: 'Senden',
      successTitle: 'Vielen Dank für Ihre Nachricht!',
      successText:
        'Wir haben Ihre Nachricht erhalten und melden uns schnellstmöglich. Für Buchungen kontaktieren Sie uns gerne direkt per E-Mail oder Telefon.',
    },
  },
}[lang]

const ctaTitle: Record<Locale, string> = {
  es: '¿Listo para reservar tu próxima inmersión?',
  en: 'Ready to book your next dive?',
  fr: 'Prêt à réserver votre prochaine plongée ?',
  de: 'Bereit, deinen nächsten Tauchgang zu buchen?',
}

---
<div class={styles.pageHeader}>
  <div class={styles.pageHeaderInner}>
    <p class={styles.pageEyebrow}>{t.eyebrow}</p>
    <h1 class={styles.pageTitle}>{t.title}</h1>
    <p class={styles.pageSubtitle}>{t.subtitle}</p>
  </div>
</div>

<section class={styles.section}>
  <div class={styles.container}>
    <div class={styles.grid}>
      <div class="info">
        <h2 class={styles.sectionTitle}>{t.contactTitle}</h2>

        <div class="infoBlock">
          <h3 class="infoLabel">{t.emailLabel}</h3>
          <a class="infoValue" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </div>

        <div class="infoBlock">
          <h3 class="infoLabel">{t.phonesLabel}</h3>
          <ul class="infoList">
            {SITE.phones.map((phone) => (
              <li key={phone.href}>
                <a class="infoValue" href={phone.href}>
                  {phone.display}
                </a>
                <span class="infoNote">{phone.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="infoBlock">
          <h3 class="infoLabel">{t.addressLabel}</h3>
          <address class="address">
            <span>{SITE.address.line1}</span>
            <span>{SITE.address.line2}</span>
            <span>{SITE.address.line3}</span>
          </address>
        </div>

        <div class="infoBlock">
          <h3 class="infoLabel">{t.socialTitle}</h3>
          <ul class="socialRow">
            <li>
              <a
                class="socialLink"
                href={SITE.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="socialIcon" aria-hidden="true">
                  <path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.631.771-1.631 1.562v1.878h2.773l-.443 2.91h-2.33v7.03C18.343 21.244 22 17.08 22 12.06"/>
                </svg>
              </a>
            </li>
            <li>
              <a
                class="socialLink"
                href={SITE.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="socialIcon" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"></circle>
                </svg>
              </a>
            </li>
            <li>
              <a
                class="socialLink"
                href={SITE.social.youtube}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="YouTube"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="socialIcon" aria-hidden="true">
                  <path d="M23.498 6.186a3.02 3.02 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.02 3.02 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.02 3.02 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.02 3.02 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814M9.545 15.568V8.432L15.818 12z"/>
                </svg>
              </a>
            </li>
            <li>
              <a
                class="socialLink"
                href={SITE.social.googleReview}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Google review"
              >
                <svg viewBox="0 0 24 24" class="socialIcon" aria-hidden="true">
                  <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82"/>
                  <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24"/>
                  <path fill="#FBBC05" d="M5.27 14.29a7.14 7.14 0 0 1 0-4.58V6.62H1.29a11.9 11.9 0 0 0 0 10.76z"/>
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96"/>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="form">
        <h2 class={styles.sectionTitle}>{t.formTitle}</h2>
        <p class={styles.bodyText}>{t.formNote}</p>
        <ContactForm labels={t.form} client:load />
      </div>
    </div>
  </div>
</section>

<CtaBanner lang={lang} href={SITE.bookingUrlDives} title={ctaTitle[lang]} />

<style>
  .info {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .infoBlock {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .infoLabel {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-ocean-400);
  }

  .infoList {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .infoList li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .infoValue {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-ocean-800);
    transition: color var(--transition);
  }

  .infoValue:hover {
    color: var(--color-ocean-500);
  }

  .infoNote {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .socialRow {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .socialLink {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-ocean-50);
    color: var(--color-ocean-800);
    transition: background var(--transition), color var(--transition);
  }

  .socialLink:hover {
    background: var(--color-ocean-800);
    color: var(--color-white);
  }

  .socialIcon {
    width: 18px;
    height: 18px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .info {
      order: 2;
    }

    .form {
      order: 1;
    }
  }
</style>
