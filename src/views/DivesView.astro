---
import CourseCard from '../components/CourseCard.astro'
import CtaBanner from '../components/CtaBanner.astro'
import Tabs from '../components/Tabs'
import { divesPageContent } from '../content/data/pageContent'
import type { Locale } from '../i18n/locales'
import { ui } from '../i18n/strings'
// src/views/DivesView.astro
// Inmersiones page — organisation prose from divesPageContent plus the certified
// experiences as cards, per docs/2. inmersiones.md.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { t } from '../sanity/localize'
import { getExperiences } from '../sanity/queries'
import rowStyles from '../styles/rowLayout.module.css'
import textWithCarousel from '../styles/TextWithCarousel.module.css'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const u = ui[lang]

const experiences = await getExperiences('certified')

const labels: Record<
  Locale,
  {
    includes: string
    supplements: string
    conditions: string
    depth: string
    gridTitle: string
    packageBadge: string
  }
> = {
  es: {
    includes: 'Incluye',
    supplements: 'Suplementos / opciones',
    conditions: 'Condiciones',
    depth: 'máx.',
    gridTitle: 'Inmersiones guiadas',
    packageBadge: 'Bono / Pack',
  },
  en: {
    includes: 'Includes',
    supplements: 'Supplements / options',
    conditions: 'Conditions',
    depth: 'max',
    gridTitle: 'Guided dives',
    packageBadge: 'Package',
  },
  fr: {
    includes: 'Inclut',
    supplements: 'Suppléments / options',
    conditions: 'Conditions',
    depth: 'max',
    gridTitle: 'Plongées encadrées',
    packageBadge: 'Forfait',
  },
  de: {
    includes: 'Inklusive',
    supplements: 'Zuschläge / Optionen',
    conditions: 'Bedingungen',
    depth: 'max.',
    gridTitle: 'Begleitete Tauchgänge',
    packageBadge: 'Paket',
  },
}
const l = labels[lang]

const descriptions: Record<Locale, string> = {
  es: 'Inmersiones guiadas para buceadores certificados en Gran Canaria: organización, horarios, requisitos y tarifas.',
  en: 'Guided dives for certified divers in Gran Canaria: organisation, schedules, requirements and prices.',
  fr: 'Plongées encadrées pour plongeurs certifiés à Grande Canarie : organisation, horaires, conditions et tarifs.',
  de: 'Begleitete Tauchgänge für zertifizierte Taucher auf Gran Canaria: Organisation, Zeiten, Voraussetzungen und Preise.',
}

const ctaTitle: Record<Locale, string> = {
  es: '¿Listo para tu próxima inmersión?',
  en: 'Ready for your next dive?',
  fr: 'Prêt pour votre prochaine plongée ?',
  de: 'Bereit für deinen nächsten Tauchgang?',
}

const depthBadge = (n: number | null | undefined): string => (n ? `${l.depth} ${n} m` : '')
const priceOf = (x: { price?: number | null }): string => (x.price ? `${x.price} €` : '')
---

<BaseLayout lang={lang} path="dives" title={`${u.nav.dives} — ${SITE.fullName}`} description={descriptions[lang]}>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{SITE.fullName}</p>
        <h1 class={styles.pageTitle}>{t(divesPageContent.introTitle, lang)}</h1>
        <p class={styles.pageSubtitle}>{t(divesPageContent.introSubtitle, lang)}</p>
      </div>
    </header>

    <!-- Tabbed content: Información | Tarifas -->
    <Tabs
      client:load
      label={u.nav.dives}
      idPrefix="dives"
      tabs={[
        { id: 'info', label: u.dives.infoTab },
        { id: 'rates', label: u.nav.rates },
      ]}
    >
      <div slot="info">
        <!-- Intro -->
        <section class={styles.section}>
          <div class={styles.container}>
            <p class={styles.sectionEyebrow}>{u.nav.dives}</p>
            <p class={styles.bodyText}>{t(divesPageContent.intro, lang)}</p>
          </div>
        </section>

        <!-- Site choice -->
        <section class={styles.sectionAlt}>
          <div class={`${styles.container} site-choice-body`}>
            <div class={textWithCarousel.grid}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{t(divesPageContent.siteChoiceTitle, lang)}</h2>
                <p class={styles.bodyText}>{t(divesPageContent.siteChoice, lang)}</p>
              </div>
              <img
                src="/assets/maps/mapa.sitio.buceo.isla.webp"
                alt={t(divesPageContent.siteChoiceTitle, lang)}
                width={800}
                height={717}
                loading="lazy"
                class="site-choice-map"
              />
            </div>
          </div>
        </section>

        <!-- Refresher -->
        <section class={styles.section}>
          <div class={styles.container}>
            <h2 class={styles.sectionTitle}>{t(divesPageContent.refresherTitle, lang)}</h2>
            <p class={styles.bodyText}>{t(divesPageContent.refresher, lang)}</p>
          </div>
        </section>

        <!-- Schedule -->
        <section class={styles.sectionAlt}>
          <div class={styles.container}>
            <h2 class={styles.sectionTitle}>{t(divesPageContent.scheduleTitle, lang)}</h2>
            <p class={styles.bodyText}>{t(divesPageContent.schedule, lang)}</p>
          </div>
        </section>

        <!-- Booking -->
        <section class={styles.section}>
          <div class={styles.container}>
            <h2 class={styles.sectionTitle}>{t(divesPageContent.bookingTitle, lang)}</h2>
            <p class={styles.bodyText}>{t(divesPageContent.booking, lang)}</p>
          </div>
        </section>

        <!-- Documentation -->
        <section class={styles.sectionAlt}>
          <div class={styles.container}>
            <h2 class={styles.sectionTitle}>{t(divesPageContent.docsTitle, lang)}</h2>
            <p class={styles.bodyText}>{t(divesPageContent.docs, lang)}</p>
          </div>
        </section>
      </div>

      <div slot="rates">
        <!-- Certified experiences -->
        <section class={styles.section}>
          <div class={styles.container}>
            <h2 class={styles.sectionTitle}>{l.gridTitle}</h2>
            <div class={rowStyles.list}>
              {experiences.map((x: any) => (
                <CourseCard
                  title={t(x.title, lang)}
                  meta={[t(x.duration, lang), depthBadge(x.depthLimit)].filter((v) => v)}
                  paragraphs={[
                    { text: t(x.description, lang) },
                    ...(t(x.includes, lang)
                      ? [{ label: l.includes, text: t(x.includes, lang) }]
                      : []),
                    ...(t(x.supplements, lang)
                      ? [{ label: l.supplements, text: t(x.supplements, lang) }]
                      : []),
                    ...(t(x.groupDiscount, lang)
                      ? [{ label: l.conditions, text: t(x.groupDiscount, lang) }]
                      : []),
                  ]}
                  price={priceOf(x) || null}
                  image={x.image || null}
                  videoUrl={x.videoUrl || null}
                  isPackage={x.isPackage}
                  packageLabel={l.packageBadge}
                />
              ))}
            </div>
          </div>
        </section>
      </div>
    </Tabs>

    <CtaBanner lang={lang} href={SITE.bookingUrlDives} title={ctaTitle[lang]} />
  </main>
</BaseLayout>

<style>
  .site-choice-body {
    max-width: 1000px;
    margin: 0 auto;
  }

  .site-choice-map {
    width: 100%;
    height: auto;
  }
</style>
