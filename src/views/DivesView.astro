---
import CourseCard from '../components/CourseCard.astro'
import CtaBanner from '../components/CtaBanner.astro'
import Tabs from '../components/Tabs'
import { divesPageContent } from '../content/data/pageContent'
import type { Locale } from '../i18n/locales'
import { localePath, withLangParam } from '../i18n/paths'
import { reserveInterestMessage, ui } from '../i18n/strings'
// src/views/DivesView.astro
// Inmersiones page — organisation prose from divesPageContent plus the certified
// experiences as cards, per docs/2. inmersiones.md.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { t, tList, tSupplements } from '../sanity/localize'
import { getExperiences } from '../sanity/queries'
import rowStyles from '../styles/rowLayout.module.css'
import textWithCarousel from '../styles/TextWithCarousel.module.css'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const u = ui[lang]

const experiences = await getExperiences('certified')

const labels: Record<
  Locale,
  {
    includes: string
    supplements: string
    conditions: string
    depth: string
    packageBadge: string
  }
> = {
  es: {
    includes: 'Incluye',
    supplements: 'Suplementos / opciones',
    conditions: 'Condiciones',
    depth: 'máx.',
    packageBadge: 'Bono / Pack',
  },
  en: {
    includes: 'Includes',
    supplements: 'Supplements / options',
    conditions: 'Conditions',
    depth: 'max',
    packageBadge: 'Package',
  },
  fr: {
    includes: 'Inclut',
    supplements: 'Suppléments / options',
    conditions: 'Conditions',
    depth: 'max',
    packageBadge: 'Forfait',
  },
  de: {
    includes: 'Inklusive',
    supplements: 'Zuschläge / Optionen',
    conditions: 'Bedingungen',
    depth: 'max.',
    packageBadge: 'Paket',
  },
}
const l = labels[lang]

const descriptions: Record<Locale, string> = {
  es: 'Inmersiones guiadas para buceadores certificados en Gran Canaria: organización, horarios, requisitos y tarifas.',
  en: 'Guided dives for certified divers in Gran Canaria: organisation, schedules, requirements and prices.',
  fr: 'Plongées encadrées pour plongeurs certifiés à Grande Canarie : organisation, horaires, conditions et tarifs.',
  de: 'Begleitete Tauchgänge für zertifizierte Taucher auf Gran Canaria: Organisation, Zeiten, Voraussetzungen und Preise.',
}

const ctaTitle: Record<Locale, string> = {
  es: '¿Listo para tu próxima inmersión?',
  en: 'Ready for your next dive?',
  fr: 'Prêt pour votre prochaine plongée ?',
  de: 'Bereit für deinen nächsten Tauchgang?',
}

const depthBadge = (n: number | null | undefined): string => (n ? `${l.depth} ${n} m` : '')
const priceOf = (x: { price?: number | null }): string => (x.price ? `${x.price} €` : '')

// Cards without a Bukyapp reservationLink fall back to the contact form
// with a prefilled "interested in X" message, opened in the same tab.
const reserveHrefOf = (x: any) =>
  x.reservationLink
    ? withLangParam(x.reservationLink, lang)
    : `${localePath(lang, 'contact')}?message=${encodeURIComponent(reserveInterestMessage(lang, t(x.title, lang)))}`
---

<BaseLayout lang={lang} path="dives" title={`${u.nav.dives} — ${SITE.fullName}`} description={descriptions[lang]}>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{SITE.fullName}</p>
        <h1 class={styles.pageTitle}>{t(divesPageContent.introTitle, lang)}</h1>
        <p class={styles.pageSubtitle}>{t(divesPageContent.introSubtitle, lang)}</p>
      </div>
    </header>

    <!-- Tabbed content: Inmersiones | Información -->
    <Tabs
      client:load
      label={u.nav.dives}
      idPrefix="dives"
      tabs={[
        { id: 'rates', label: u.dives.ratesTab },
        { id: 'info', label: u.dives.infoTab },
      ]}
    >
      <div slot="info">
        <!-- Intro -->
        <section class={styles.section}>
          <div class={styles.container}>
            <p class={styles.sectionEyebrow}>{u.nav.dives}</p>
            <p class={styles.bodyText}>{t(divesPageContent.intro, lang)}</p>
          </div>
        </section>

        <!-- Site choice -->
        <section class={styles.sectionAlt}>
          <div class={`${styles.container} site-choice-body`}>
            <div class={textWithCarousel.grid}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{t(divesPageContent.siteChoiceTitle, lang)}</h2>
                <p class={styles.bodyText}>{t(divesPageContent.siteChoice, lang)}</p>
              </div>
              <img
                src="/assets/maps/mapa.sitio.buceo.isla.webp"
                alt={t(divesPageContent.siteChoiceTitle, lang)}
                width={800}
                height={717}
                loading="lazy"
                class="site-choice-map"
              />
            </div>
          </div>
        </section>

        <!-- Refresher -->
        <section class={styles.section}>
          <div class={styles.container}>
            <div class={`${textWithCarousel.grid} refresher-grid`}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{t(divesPageContent.refresherTitle, lang)}</h2>
                <p class={styles.bodyText}>{t(divesPageContent.refresher, lang)}</p>
              </div>
              <img
                src="/assets/refresh.webp"
                alt={t(divesPageContent.refresherTitle, lang)}
                width={1536}
                height={1024}
                loading="lazy"
                class="refresher-image"
              />
            </div>
          </div>
        </section>

        <!-- Schedule -->
        <section class={styles.sectionAlt}>
          <div class={styles.container}>
            <h2 class={styles.sectionTitle}>{t(divesPageContent.scheduleTitle, lang)}</h2>
            <p class={styles.bodyText}>{t(divesPageContent.schedule, lang)}</p>
          </div>
        </section>

        <!-- Booking -->
        <section class={styles.section}>
          <div class={styles.container}>
            <div class={textWithCarousel.grid}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{t(divesPageContent.bookingTitle, lang)}</h2>
                <p class={styles.bodyText}>{t(divesPageContent.booking, lang)}</p>
              </div>
              <img
                src="/assets/reservar.webp"
                alt={t(divesPageContent.bookingTitle, lang)}
                width={1672}
                height={941}
                loading="lazy"
                class="booking-image"
              />
            </div>
          </div>
        </section>

        <!-- Documentation -->
        <section class={styles.sectionAlt}>
          <div class={styles.container}>
            <div class={textWithCarousel.grid}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{t(divesPageContent.docsTitle, lang)}</h2>
                <p class={styles.bodyText}>{t(divesPageContent.docs, lang)}</p>
              </div>
              <img
                src="/assets/documentation/scuba-license.webp"
                alt={t(divesPageContent.docsTitle, lang)}
                width={1000}
                height={532}
                loading="lazy"
                class="docs-license-image"
              />
            </div>
          </div>
        </section>
      </div>

      <div slot="rates">
        <!-- Certified experiences -->
        <section class={styles.section}>
          <div class={styles.container}>
            <div class={rowStyles.list}>
              {experiences.map((x: any) => (
                <CourseCard
                  title={t(x.title, lang)}
                  meta={[t(x.duration, lang), depthBadge(x.depthLimit)].filter((v) => v)}
                  paragraphs={[
                    { text: t(x.description, lang) },
                    ...(tList(x.includes, lang).length
                      ? [{ label: l.includes, items: tList(x.includes, lang) }]
                      : []),
                    ...(tSupplements(x.supplements, lang).length
                      ? [{ label: l.supplements, supplements: tSupplements(x.supplements, lang) }]
                      : []),
                    ...(t(x.groupDiscount, lang)
                      ? [{ label: l.conditions, text: t(x.groupDiscount, lang) }]
                      : []),
                  ]}
                  price={priceOf(x) || null}
                  image={x.image || null}
                  videoUrl={x.videoUrl || null}
                  isPackage={x.isPackage}
                  packageLabel={l.packageBadge}
                  reserveHref={reserveHrefOf(x)}
                  reserveLabel={u.book}
                  reserveExternal={!!x.reservationLink}
                />
              ))}
            </div>
          </div>
        </section>
      </div>
    </Tabs>

    <CtaBanner lang={lang} href={SITE.bookingUrlDives} title={ctaTitle[lang]} />
  </main>
</BaseLayout>

<style>
  .site-choice-body {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Grid rows in TextWithCarousel.module.css default to stretch: giving the
     image height: 100% (instead of auto, which only sizes to its own aspect
     ratio) makes it fill the row up to the text column's height, with
     object-fit cropping instead of distorting. */
  .site-choice-map {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .docs-license-image,
  .booking-image,
  .refresher-image {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    object-fit: cover;
  }

  /* Repaso (refresher): on desktop the 3:2 photo is taller than the text
     column, so it drives the grid row height and ends up bigger than the
     text. Absolute positioning takes the image out of grid track sizing,
     so the text defines the row and the image adapts to its height (cover
     crops instead of distorting). On mobile the grid stacks, so the image
     keeps its in-flow size below the text. */
  @media (min-width: 901px) {
    /* .grid (shared with other sections via TextWithCarousel.module.css)
       isn't position: relative, so without this the absolutely-positioned
       image's containing block falls back to the viewport instead of the
       grid, and it renders as a giant, misplaced image. Scope the
       positioning to this section only. */
    .refresher-grid {
      position: relative;
    }

    .refresher-image {
      position: absolute;
      inset: 0;
      /* Without an explicit column, an absolutely-positioned grid item with
         no grid-row/grid-column defaults to spanning the *entire* grid, so
         inset: 0 would stretch it across both the text and image columns.
         Pin it to the image column only. */
      grid-column: 2;
    }
  }
</style>
