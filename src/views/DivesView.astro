---
import CourseCard from '../components/CourseCard.astro'
import CtaBanner from '../components/CtaBanner.astro'
import Tabs from '../components/Tabs'
import type { Locale } from '../i18n/locales'
import { withLangParam } from '../i18n/paths'
import { reserveInterestMailtoFrom } from '../i18n/strings'
// src/views/DivesView.astro
// Inmersiones page — organisation prose from the divesPage singleton plus the certified
// experiences as cards, per docs/2. inmersiones.md.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { resolveOgImage, sanityImageUrl } from '../lib/seo'
import { t, tList, tSupplements } from '../sanity/localize'
import { getCentroInfo, getDives, getPageTexts, getUi } from '../sanity/queries'
import rowStyles from '../styles/rowLayout.module.css'
import textWithCarousel from '../styles/TextWithCarousel.module.css'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const u = await getUi(lang)

const experiences = await getDives()
const centroInfo = await getCentroInfo()
const ogImage = resolveOgImage(centroInfo, 'dives')

// Feature flag (`centroInfo.hideDivesTab`): hide the Inmersiones tab. When it is
// hidden the Información tab is hidden too, and its content renders directly as
// plain sections (Tabs drops the tab strip when it only has one tab).
const hideDivesTab = centroInfo?.hideDivesTab === true

const page = await getPageTexts('divesPage', lang)
// The info-tab blocks (Studio: "Secciones"), looked up by their fixed key.
const sec = Object.fromEntries(page.sections.map((s) => [s.key, s]))
const l = u.cardLabels

const descriptions: Record<Locale, string> = {
  es: 'Inmersiones guiadas para buceadores certificados en Gran Canaria: organización, horarios, requisitos y tarifas.',
  en: 'Guided dives for certified divers in Gran Canaria: organisation, schedules, requirements and prices.',
  fr: 'Plongées encadrées pour plongeurs certifiés à Gran Canaria : organisation, horaires, conditions et tarifs.',
  de: 'Begleitete Tauchgänge für zertifizierte Taucher auf Gran Canaria: Organisation, Zeiten, Voraussetzungen und Preise.',
}

const depthBadge = (n: number | null | undefined): string => (n ? `${l.depth} ${n} m` : '')
const priceOf = (x: { price?: number | null }): string => (x.price ? `${x.price} €` : '')

// Cards without a Bukyapp reservationLink fall back to a mailto: with a
// prefilled "interested in X" subject and body.
const reserveHrefOf = (x: any) =>
  x.reservationLink
    ? withLangParam(x.reservationLink, lang)
    : reserveInterestMailtoFrom(u, t(x.title, lang))
---

<BaseLayout lang={lang} path="dives" title={`${u.nav.dives} — ${SITE.fullName}`} description={descriptions[lang]} ogImage={ogImage}>
  <main>
    <header class={styles.pageHeader}>
      <div class={styles.pageHeaderInner}>
        <p class={styles.pageEyebrow}>{SITE.fullName}</p>
        <h1 class={styles.pageTitle}>{page.introTitle}</h1>
        <p class={styles.pageSubtitle}>{page.introSubtitle}</p>
      </div>
    </header>

    <!-- Tabbed content: Información | Inmersiones -->
    <Tabs
      client:load
      label={u.nav.dives}
      idPrefix="dives"
      tabs={
        hideDivesTab
          ? [{ id: 'info', label: page.infoTab }]
          : [
              { id: 'info', label: page.infoTab },
              { id: 'rates', label: page.ratesTab },
            ]
      }
    >
      <div slot="info">
        <!-- Intro -->
        <section class={styles.section}>
          <div class={styles.container}>
            <p class={styles.sectionEyebrow}>{sec.intro.eyebrow}</p>
            <p class={styles.bodyText}>{sec.intro.body}</p>
          </div>
        </section>

        <!-- Site choice -->
        <section class={styles.sectionAlt}>
          <div class={`${styles.container} site-choice-body`}>
            <div class={textWithCarousel.grid}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{sec.siteChoice.title}</h2>
                <p class={styles.bodyText}>{sec.siteChoice.body}</p>
              </div>
              <figure class="imageFrame">
                <img
                  src={sanityImageUrl(sec.siteChoice.image)}
                  alt={sec.siteChoice.title}
                  width={sec.siteChoice.imageWidth}
                  height={sec.siteChoice.imageHeight}
                  loading="lazy"
                  class="site-choice-map"
                />
              </figure>
            </div>
          </div>
        </section>

        <!-- Refresher -->
        <section class={styles.section}>
          <div class={styles.container}>
            <div class={`${textWithCarousel.grid} image-left`}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{sec.refresher.title}</h2>
                <p class={styles.bodyText}>{sec.refresher.body}</p>
              </div>
              <figure class="imageFrame">
                <img
                  src={sanityImageUrl(sec.refresher.image)}
                  alt={sec.refresher.title}
                  width={sec.refresher.imageWidth}
                  height={sec.refresher.imageHeight}
                  loading="lazy"
                  class="refresher-image"
                />
              </figure>
            </div>
          </div>
        </section>

        <!-- Schedule -->
        <section class={styles.sectionAlt}>
          <div class={styles.container}>
            <div class={textWithCarousel.grid}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{sec.schedule.title}</h2>
                <p class={styles.bodyText}>{sec.schedule.body}</p>
              </div>
              <figure class="imageFrame">
                <img
                  src={sanityImageUrl(sec.schedule.image)}
                  alt={sec.schedule.title}
                  width={sec.schedule.imageWidth}
                  height={sec.schedule.imageHeight}
                  loading="lazy"
                  class="schedule-image"
                />
              </figure>
            </div>
          </div>
        </section>

        <!-- Booking -->
        <section class={styles.section}>
          <div class={styles.container}>
            <div class={`${textWithCarousel.grid} image-left`}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{sec.booking.title}</h2>
                <p class={styles.bodyText}>{sec.booking.body}</p>
              </div>
              <figure class="imageFrame">
                <img
                  src={sanityImageUrl(sec.booking.image)}
                  alt={sec.booking.title}
                  width={sec.booking.imageWidth}
                  height={sec.booking.imageHeight}
                  loading="lazy"
                  class="booking-image"
                />
              </figure>
            </div>
          </div>
        </section>

        <!-- Documentation -->
        <section class={styles.sectionAlt}>
          <div class={styles.container}>
            <div class={textWithCarousel.grid}>
              <div class={textWithCarousel.text}>
                <h2 class={styles.sectionTitle}>{sec.docs.title}</h2>
                <p class={styles.bodyText}>{sec.docs.body}</p>
              </div>
              <figure class="imageFrame">
                <img
                  src={sanityImageUrl(sec.docs.image)}
                  alt={sec.docs.title}
                  width={sec.docs.imageWidth}
                  height={sec.docs.imageHeight}
                  loading="lazy"
                  class="docs-license-image"
                />
              </figure>
            </div>
          </div>
        </section>
      </div>

      {!hideDivesTab && (
        <div slot="rates">
          <!-- Certified experiences -->
          <section class={styles.section}>
            <div class={styles.container}>
              <div class={rowStyles.list}>
                {experiences.map((x: any) => (
                  <CourseCard
                    title={t(x.title, lang)}
                    meta={[t(x.duration, lang), depthBadge(x.depthLimit)].filter((v) => v)}
                    paragraphs={[
                      { text: t(x.description, lang) },
                      ...(tList(x.includes, lang).length
                        ? [{ label: l.includes, items: tList(x.includes, lang) }]
                        : []),
                      ...(tSupplements(x.supplements, lang).length
                        ? [{ label: l.supplements, supplements: tSupplements(x.supplements, lang) }]
                        : []),
                      ...(tList(x.requirements, lang).length
                        ? [{ label: l.requirements, requirements: tList(x.requirements, lang) }]
                        : []),
                    ]}
                    price={priceOf(x) || null}
                    image={x.image || null}
                    videoUrl={x.videoUrl || null}
                    isPackage={x.isPackage}
                    packageLabel={l.packageBadge}
                    reserveHref={reserveHrefOf(x)}
                    reserveLabel={u.book}
                    reserveExternal={!!x.reservationLink}
                  />
                ))}
              </div>
            </div>
          </section>
        </div>
      )}
    </Tabs>

    <CtaBanner lang={lang} href={SITE.bookingUrlDives} title={page.ctaTitle} />
  </main>
</BaseLayout>

<style>
  .site-choice-body {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* <figure> ships a default margin; the grid gap already provides spacing. */
  .imageFrame {
    margin: 0;
  }

  /* Below 901px this is the only sizing that applies: the grid stacks to a
     single column, so height: 100% resolves against an indefinite parent
     height and falls back to auto, i.e. the image just keeps its own aspect
     ratio (see width/height attrs above). */
  .site-choice-map,
  .docs-license-image,
  .booking-image,
  .refresher-image,
  .schedule-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Map, not a photo — no card styling. */
  .docs-license-image,
  .booking-image,
  .refresher-image,
  .schedule-image {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 901px) {
    /* The five info-tab photos alternate sides (left, right, left, right…):
       refresher left, schedule right, booking left, documentation right.
       The .image-left modifier swaps the two grid columns so the photo sits
       on the left and the text on the right; sections without it keep the
       default (text left, photo right). Child selectors are used because
       the grid/text classes come from the shared TextWithCarousel CSS
       module and can't be targeted by name from this scoped style block;
       <figure> vs <div> tells the two children apart. */
    .image-left > div {
      grid-column: 2;
      grid-row: 1;
    }

    .image-left > figure {
      grid-column: 1;
      grid-row: 1;
    }

    /* Without this, a tall photo would drive the grid row's auto height
       and end up taller than the text next to it. .imageFrame has no
       in-flow content (its image is taken out of flow below), so it
       contributes 0 to the row's height — the text alone sizes the row.
       align-items: stretch (the grid's default) then stretches the frame
       to that row height, and the absolutely-positioned image fills the
       frame, cropped via object-fit instead of overflowing it.

       The site-choice map is deliberately left out of this: it's a
       reference map (not a mood photo), so cropping it down to a short
       paragraph's height would cut off parts of the island. It stays
       in-flow at its own natural aspect ratio instead, sized by whatever
       height it needs. */
    .imageFrame {
      position: relative;
    }

    .docs-license-image,
    .booking-image,
    .refresher-image,
    .schedule-image {
      position: absolute;
      inset: 0;
    }
  }
</style>
