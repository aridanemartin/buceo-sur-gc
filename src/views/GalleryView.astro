---
import CtaBanner from '../components/CtaBanner.astro'
import GallerySwiper from '../components/GallerySwiper.tsx'
import { galleryPageContent } from '../content/data/pageContent'
import type { Locale } from '../i18n/locales'
import { ui } from '../i18n/strings'
// src/views/GalleryView.astro
// Galería page: intro copy, then one section per dive site with meta pills
// (depth range + level), localized description and a one-image-at-a-time
// swiper of the site's photos — the optional YouTube video is its own slide.
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../lib/constants'
import { resolveOgImage } from '../lib/seo'
import { t } from '../sanity/localize'
import { getCentroInfo, getDiveSites } from '../sanity/queries'
import styles from '../styles/viewCommon.module.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const strings = ui[lang]
const sites = await getDiveSites()
const introTitle = t(galleryPageContent.introTitle, lang)
const intro = t(galleryPageContent.intro, lang)
const centroInfo = await getCentroInfo()
const ogImage = resolveOgImage(centroInfo, 'gallery')
---

<BaseLayout lang={lang} path="gallery" title={introTitle} description={intro} ogImage={ogImage}>
  <header class={styles.pageHeader}>
    <div class={styles.pageHeaderInner}>
      <p class={styles.pageEyebrow}>{strings.nav.gallery}</p>
      <h1 class={styles.pageTitle}>{introTitle}</h1>
      <p class={styles.pageSubtitle}>{intro}</p>
    </div>
  </header>

  <main>
    {
      sites.map((site) => {
        const siteName = t(site.name, lang)
        return (
          <section class={styles.section} id={`site-${site.order}`}>
            <div class={`${styles.container} gallery-body`}>
              <h2 class={styles.sectionTitle}>{siteName}</h2>
              <ul class={styles.cardMeta}>
                <li>{site.depthRange}</li>
                <li>{t(site.levelTag, lang)}</li>
              </ul>
              <p class={styles.bodyText}>{t(site.description, lang)}</p>
              <GallerySwiper
                images={(site.images ?? []).map((url) => ({ url, alt: siteName }))}
                videoUrl={site.youtubeUrl}
                videoAlt={siteName}
                videoFirst={site.youtubeFirst}
                client:visible
              />
            </div>
          </section>
        )
      })
    }
  </main>

  <CtaBanner lang={lang} href={SITE.bookingUrlDives} title={strings.book} />
</BaseLayout>

<style>
  .gallery-body {
    max-width: 900px;
    margin: 0 auto;
  }

  main > section {
    padding-top: 0;
  }

  main > section:first-of-type {
    padding-top: var(--section-py);
  }
</style>
